# Copy to .env and adjust for local development.

# --- Django ---
# Celery needs this. manage.py already defaults to core.settings.dev.
DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (SRS: PostgreSQL 18+ with PostGIS) ---
# PostgreSQL for production. Comment out to use SQLite fallback for local dev.
# DATABASE_URL=postgres://rzdo:rzdo@localhost:5432/rzdo

# --- Cache / queue (SRS: Redis Streams or Kafka) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Crawler tunables ---
# Default per-source crawl interval in seconds (override per source)
CRAWLER_DEFAULT_INTERVAL_SECONDS=3600
# Retry back-off schedule in minutes (1, 4, 16)
CRAWLER_RETRY_BACKOFF_MINUTES=1,4,16
# Semantic-similarity threshold for duplicate suppression (default 0.85)
CRAWLER_SEMANTIC_DEDUP_THRESHOLD=0.85
# Headless browser for pages that are empty until JavaScript runs.
# Needs: pipenv run playwright install chromium
CRAWLER_BROWSER_ENABLED=True
CRAWLER_BROWSER_TIMEOUT_SECONDS=30
# Following links from list pages (crawl depth 2 or more).
CRAWLER_MAX_PAGES_PER_RUN=50
CRAWLER_LINK_DELAY_SECONDS=1

# --- Outbound (handoff to LLM service) ---
# False: crawls keep matched articles as "matched" and do not contact Redis.
LLM_QUEUE_ENABLED=True
LLM_QUEUE_NAME=rzdo.matched_articles

# --- LLM extraction (run_llm_worker) ---
# Service account key with the Vertex AI User role. Keep the file outside the repo.
RZDO_GCP_PROJECT=
RZDO_GCP_CREDENTIALS=
LLM_MODEL=gemini-3.5-flash-lite
LLM_GCP_LOCATION=global
# Article-specific failures before a message moves to the dead-letter stream.
LLM_MAX_ATTEMPTS=3
# Longer article bodies are cut to this length before being sent to the model.
LLM_MAX_INPUT_CHARS=50000
LLM_REQUEST_TIMEOUT_SECONDS=300
# Unfinished messages are retried after this long. Keep above the request timeout.
LLM_CLAIM_IDLE_SECONDS=600

# --- External feeds ---
# WHO-EIOS API. Service-to-service OAuth2 client-credentials flow: the
# crawler exchanges the client credentials for a ~1h bearer token and refreshes it.
EIOS_API_BASE_URL=https://eios.who.int/portal/api
# Sandbox (https://eios.who.int/portal-sandbox/api) needs separately provisioned credentials.
EIOS_API_VERSION=1.0
EIOS_TOKEN_URL=https://login.microsoftonline.com/f610c0b7-bd24-4b39-810b-3dc280afb590/oauth2/v2.0/token
EIOS_CLIENT_ID=
EIOS_CLIENT_SECRET=
EIOS_SCOPE=
# First-run look-back in hours; later runs resume from the last crawl.
# A broad board can return ~75k articles/day, so keep this small at first.
EIOS_BACKFILL_HOURS=24
# Board is read in time windows; each must hold < 10,000 articles (API paging limit).
# Windows over the limit are split automatically.
EIOS_WINDOW_MINUTES=60
# Articles per page (API max 100).
EIOS_PAGE_SIZE=100
# Original article pages fetched in parallel for full text.
EIOS_LINK_FETCH_WORKERS=16
