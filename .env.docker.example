# Dev server settings for docker compose. On the server: cp .env.docker.example .env
# Avoid "$" in values, or wrap the value in single quotes: Compose treats "$" as a variable.

# --- Django ---
# prod.py: DEBUG off, HTTPS only and secure cookies. HTTPS is handled by the server's nginx.
DJANGO_SETTINGS_MODULE=core.settings.prod
DJANGO_BEHIND_HTTPS_PROXY=True
# Generate with: openssl rand -hex 32
DJANGO_SECRET_KEY=
# Keep localhost: the container health check uses it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,rzdo.sharful.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://rzdo.sharful.com

# Local port the server's nginx forwards to. Must match nginx/host-rzdo.conf.
WEB_PORT=8100

# --- Database ---
# Goes into a URL, so use letters and numbers only. Generate with: openssl rand -hex 24
# It is applied only when the database volume is first created.
POSTGRES_USER=rzdo
POSTGRES_PASSWORD=
POSTGRES_DB=rzdo

# DATABASE_URL, REDIS_URL, CELERY_BROKER_URL, CELERY_RESULT_BACKEND and RZDO_GCP_CREDENTIALS
# are set in compose.yml, so setting them here has no effect.

# --- Crawler tunables ---
CRAWLER_DEFAULT_INTERVAL_SECONDS=3600
CRAWLER_RETRY_BACKOFF_MINUTES=1,4,16
CRAWLER_SEMANTIC_DEDUP_THRESHOLD=0.85
CRAWLER_BROWSER_ENABLED=True
CRAWLER_BROWSER_TIMEOUT_SECONDS=30
CRAWLER_MAX_PAGES_PER_RUN=50
CRAWLER_LINK_DELAY_SECONDS=1

# --- LLM extraction ---
# False: crawls keep matched articles as "matched" and do not contact Redis.
# Set to True when Redis is on and crawled articles should go to the queue by themselves.
LLM_QUEUE_ENABLED=False
# Put the service account key at secrets/gcp-key.json, readable by uid 1000.
RZDO_GCP_PROJECT=
LLM_MODEL=gemini-3.5-flash-lite
LLM_GCP_LOCATION=global

# --- WHO-EIOS feed ---
EIOS_API_BASE_URL=https://eios.who.int/portal/api
EIOS_API_VERSION=1.0
EIOS_TOKEN_URL=https://login.microsoftonline.com/f610c0b7-bd24-4b39-810b-3dc280afb590/oauth2/v2.0/token
EIOS_CLIENT_ID=
EIOS_CLIENT_SECRET=
EIOS_SCOPE=
EIOS_BACKFILL_HOURS=24
EIOS_WINDOW_MINUTES=60
EIOS_PAGE_SIZE=100
EIOS_LINK_FETCH_WORKERS=16
