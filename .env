# Copy to .env and adjust for local development.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (SRS: PostgreSQL 18+ with PostGIS) ---
# PostgreSQL for production. Comment out to use SQLite fallback for local dev.
# DATABASE_URL=postgres://unicrawl:unicrawl@localhost:5432/unicrawl

# --- Cache / queue (SRS: Redis Streams or Kafka) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Crawler tunables ---
# Default per-source crawl interval in seconds (FR-10; override per source)
CRAWLER_DEFAULT_INTERVAL_SECONDS=3600
# Retry back-off schedule in minutes (FR-14: 1, 4, 16)
CRAWLER_RETRY_BACKOFF_MINUTES=1,4,16
# Semantic-similarity threshold for duplicate suppression (FR-11/FR-23, default 0.85)
CRAWLER_SEMANTIC_DEDUP_THRESHOLD=0.85

# --- Outbound (handoff to LLM service) ---
LLM_QUEUE_NAME=unicrawl.matched_articles

# --- External feeds ---
# EIOS API credentials (FR-07). Leave blank until provisioned.
EIOS_API_BASE_URL=
EIOS_API_TOKEN=
